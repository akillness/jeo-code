{
  "name": "jeo-code",
  "version": "0.1.0",
  "description": "Clean, highly optimized AI coding agent using spec-first loop",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "joc": "src/cli.ts"
  },
  "files": [
    "src",
    "scripts/install.sh",
    "scripts/uninstall.sh",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akillness/jeo-code.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "bun src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/joc",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
