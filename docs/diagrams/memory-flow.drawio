        <mxCell id="sPref" value="preferences/*.md&#10;(UserPreference)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="store"><mxGeometry x="200" y="106" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="sConcept" value="each concept = YAML frontmatter&#10;(type · title · description · tags ·&#10;confidence · links) + markdown body" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="store"><mxGeometry x="30" y="166" width="320" height="48" as="geometry"/></mxCell>
        <mxCell id="sIndex" value="index.md&#10;progressive-disclosure links&#10;- [title](/relpath) — desc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="store"><mxGeometry x="30" y="232" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="sLog" value="log.md&#10;## YYYY-MM-DD&#10;* **type**: title" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="store"><mxGeometry x="200" y="232" width="150" height="56" as="geometry"/></mxCell>
        <mxCell id="sGraph" value="cross-link graph (Sprint 04)&#10;buildConceptGraph / expandByGraph&#10;lintMemoryBundle — graphify-optional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="store"><mxGeometry x="30" y="304" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="sLegacy" value="MEMORY.md  (legacy single doc — fallback)&#10;MEMORY.md.bak  (rollback backup after migrate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="store"><mxGeometry x="30" y="372" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="sRaw" value="raw/  — immutable session payloads (skipped on read)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="store"><mxGeometry x="30" y="436" width="320" height="36" as="geometry"/></mxCell>

        <!-- ============ READ / INJECT LANE ============ -->
        <mxCell id="readLane" value="READ — memoryPromptSection(cwd, query) → system prompt" style="swimlane;startSize=28;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="370" height="640" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Session start / prompt build&#10;(query = current task text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readLane"><mxGeometry x="95" y="44" width="180" height="44" as="geometry"/></mxCell>
        <mxCell id="rNo" value="JEO_NO_MEMORY=1 → return '' (wins over all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="readLane"><mxGeometry x="30" y="108" width="310" height="34" as="geometry"/></mxCell>
        <mxCell id="rLeg" value="JEO_MEMORY_LEGACY=1 → read MEMORY.md (or .bak),&#10;skip bundle  [rollback toggle]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="readLane"><mxGeometry x="30" y="156" width="310" height="40" as="geometry"/></mxCell>
        <mxCell id="r2" value="loadConcepts() — bundle has concepts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readLane"><mxGeometry x="100" y="212" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="r3" value="selectWithinBudget()&#10;priorityOrder: high-confidence core →&#10;query relevance (scoreConcept) →&#10;1-hop graph neighbours → stable order&#10;keep whole concepts ≤ MEMORY_INJECT_MAX_CHARS (3000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="readLane"><mxGeometry x="30" y="316" width="310" height="92" as="geometry"/></mxCell>
        <mxCell id="r3b" value="else → legacy loadMemory(MEMORY.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="readLane"><mxGeometry x="60" y="424" width="250" height="34" as="geometry"/></mxCell>
        <mxCell id="r4" value="frameMemory()&#10;• hard char cap (never mid-concept cut)&#10;• neutralize &lt;project_memory&gt; fence tags&#10;• DATA framing (injection-hardened)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="readLane"><mxGeometry x="30" y="478" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="r5" value="&lt;project_memory&gt; … &lt;/project_memory&gt;&#10;injected into the system prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="readLane"><mxGeometry x="55" y="582" width="260" height="44" as="geometry"/></mxCell>

        <!-- read edges -->
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="readLane" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontColor=#666666;" edge="1" parent="readLane" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontColor=#666666;" edge="1" parent="readLane" source="r2" target="r3b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="readLane" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="readLane" source="r3b" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="readLane" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ cross-lane edges (write → store → read) ============ -->
        <mxCell id="x1" value="atomic writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontColor=#666666;" edge="1" parent="1" source="wReindex" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x2" value="fallback doc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#666666;" edge="1" parent="1" source="wNo" target="sLegacy"><mxGeometry relative="1" as="geometry"/></mxCell>
