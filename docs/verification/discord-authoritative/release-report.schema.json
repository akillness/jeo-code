{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akillness/jeo-code/blob/main/docs/verification/discord-authoritative/release-report.schema.json",
  "title": "jeo-code Discord authoritative release report",
  "type": "object",
  "required": ["$schema", "schemaVersion", "kind", "authoritativeRepository", "commitSha", "workingTree", "commands", "testTotals", "package", "buildContract", "releaseState", "status"],
  "properties": {
    "$schema": { "type": "string", "const": "https://github.com/akillness/jeo-code/blob/main/docs/verification/discord-authoritative/release-report.schema.json" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "authoritativeRepository": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workingTree": { "type": "object", "required": ["dirty", "contentDigest"], "properties": { "dirty": { "type": "boolean" }, "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "package": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "releaseState": { "type": "object", "required": ["credentialCheck", "gitPush", "npmPublication", "correspondenceRule"], "properties": { "credentialCheck": { "$ref": "#/$defs/releaseStage" }, "gitPush": { "$ref": "#/$defs/gitPushStage" }, "npmPublication": { "$ref": "#/$defs/npmPublicationStage" }, "correspondenceRule": { "type": "string", "minLength": 1 } } }
  },
  "$defs": {
    "releaseStage": {
      "type": "object",
      "required": ["status", "startedAt", "completedAt", "evidence"],
      "properties": {
        "status": { "enum": ["not_attempted", "skipped", "failed", "succeeded"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "object" }
      },
      "allOf": [{ "if": { "required": ["status"], "properties": { "status": { "not": { "const": "succeeded" } } } }, "then": { "required": ["reason"] } }]
    },
    "gitPushStage": {
      "allOf": [
        { "$ref": "#/$defs/releaseStage" },
        { "if": { "properties": { "status": { "const": "succeeded" } } }, "then": { "properties": { "evidence": { "required": ["remoteUrl", "ref", "remotelyVerifiedCommitSha"], "properties": { "remoteUrl": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 }, "remotelyVerifiedCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } } } } }
      ]
    },
    "npmPublicationStage": {
      "allOf": [
        { "$ref": "#/$defs/releaseStage" },
        { "if": { "properties": { "status": { "const": "succeeded" } } }, "then": { "properties": { "evidence": { "required": ["registry", "packageName", "version", "registryLookup", "correspondence"], "properties": { "registry": { "type": "string", "minLength": 1 }, "packageName": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "registryLookup": { "type": "string", "minLength": 1 }, "correspondence": { "type": "string", "minLength": 1 } } } } } }
      ]
    }
  }
}
