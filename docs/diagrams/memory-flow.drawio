        <!-- ============ MIGRATION (one-shot) ============ -->
        <mxCell id="migLane" value="MIGRATION — `jeo memory-migrate` (one-shot, idempotent) · Sprint 05" style="swimlane;startSize=28;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1">
